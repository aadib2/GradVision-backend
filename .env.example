# Required. Generate with: openssl rand -hex 32
JWT_SECRET_KEY=

# Optional locally (defaults to sqlite:///./gradvision.db).
# On Render, link a Postgres database so DATABASE_URL is injected.
# Example: postgresql://user:pass@host:5432/gradvision
DATABASE_URL=

# Optional. Comma-separated browser origins allowed by CORS.
# Defaults to http://localhost:3000 and http://127.0.0.1:3000 when unset.
# Example production: https://your-app.vercel.app
CORS_ORIGINS=
